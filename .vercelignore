# Vercel ignore - fichiers à ne pas uploader lors du déploiement

# Backup configs
*.backup
vercel.json.monorepo.backup

# Node modules (installés automatiquement)
node_modules/
*/node_modules/

# Tests
*.test.js
*.spec.js
__tests__/
coverage/

# Development
.env.local
.env.development
*.log

# Git
.git/
.gitignore
