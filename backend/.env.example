# Server Configuration
PORT=4000
NODE_ENV=development

# Database Configuration (PostgreSQL pour production, SQLite pour dev)
# IMPORTANT: NEVER commit real credentials to version control!
# Production example:
# DATABASE_URL=postgresql://username:password@host:port/database?pgbouncer=true
# Development (SQLite):
DATABASE_URL=file:./dev.db

# Security
# Generate a secure random string for JWT_SECRET using: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-256-bit-secret-key-here-generate-using-crypto-randomBytes

# CORS - Origins autorisées (séparées par des virgules)
# IMPORTANT EN PRODUCTION: Lister explicitement toutes les origins autorisées
# Exemples:
# - Vercel: https://your-app.vercel.app,https://your-app-git-main-user.vercel.app
# - Netlify: https://your-app.netlify.app
# - Custom domain: https://www.example.com,https://example.com
# ÉVITER les wildcards (*) en production pour la sécurité
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Alternative: définir une seule origin principale
# CORS_ORIGIN=https://wiw-app.vercel.app

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Email Configuration (required for password reset and notifications)
# SMTP Settings - exemples pour différents fournisseurs:
# Gmail: smtp.gmail.com, port 587, créer un "App Password" dans les paramètres Google
# Outlook: smtp-mail.outlook.com, port 587
# SendGrid: smtp.sendgrid.net, port 587
# Mailgun: smtp.mailgun.org, port 587
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-specific-password
EMAIL_FROM=noreply@wiw-ae-plus.com

# Frontend URL (used in email links)
FRONTEND_URL=http://localhost:5173
