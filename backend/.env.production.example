# Production Environment Variables for Backend
# Copy to .env.production and fill with real values

# Server
NODE_ENV=production
PORT=4000

# Database (use your production database URL)
# For Scallingo, Render, Supabase, etc. - they provide the full URL
# Example with SSL and connection pooling:
DATABASE_URL=postgresql://user:password@your-db-host:5432/wiw?schema=public&sslmode=require&connection_limit=10

# For connection pooling with PgBouncer, add:
# DATABASE_URL=postgresql://user:password@your-pgbouncer-host:6543/wiw?pgbouncer=true

# JWT Secret (generate a strong random secret)
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_STRING

# CORS (add your production frontend URL)
ALLOWED_ORIGINS=https://your-frontend-domain.com

# API Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DIR=/app/uploads

# Logging
LOG_LEVEL=info
