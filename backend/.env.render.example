# WIW-AE+ Backend - Variables d'environnement pour Render
# Copier ce fichier vers .env et renseigner les valeurs

# ===========================================
# BASE DE DONNÉES
# ===========================================
# Render fournit automatiquement cette URL via le Blueprint
DATABASE_URL="postgresql://user:password@host:5432/wiw_ae_production"

# ===========================================
# AUTHENTIFICATION JWT
# ===========================================
# Secret pour signer les tokens (généré automatiquement par Render)
JWT_SECRET="votre-secret-jwt-tres-long-et-securise"
JWT_EXPIRES_IN="7d"

# ===========================================
# SERVEUR
# ===========================================
NODE_ENV="production"
PORT=5000

# ===========================================
# CORS
# ===========================================
# URL du frontend (fournie automatiquement par Render)
FRONTEND_URL="https://wiw-ae-frontend.onrender.com"
CORS_ORIGIN="https://wiw-ae-frontend.onrender.com"

# ===========================================
# EMAIL (Optionnel - pour réinitialisation mot de passe)
# ===========================================
# SMTP_HOST="smtp.example.com"
# SMTP_PORT=587
# SMTP_USER="user@example.com"
# SMTP_PASS="password"
# SMTP_FROM="noreply@wiw-ae.com"

# ===========================================
# 2FA (Optionnel)
# ===========================================
# TWO_FACTOR_APP_NAME="WIW-AE+"
