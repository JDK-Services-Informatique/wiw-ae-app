# WIW-AE+ Backend - Variables d'Environnement Railway
# Copier ces variables dans Railway Dashboard → Service Backend → Variables

# ============================================
# SERVEUR
# ============================================
NODE_ENV=production
PORT=4000
HOST=0.0.0.0

# ============================================
# BASE DE DONNÉES
# ============================================
# Railway auto-injecte cette variable si PostgreSQL est dans le même projet
# Sinon, utiliser la référence: ${{Postgres.DATABASE_URL}}
DATABASE_URL=${{Postgres.DATABASE_URL}}

# ============================================
# SÉCURITÉ - JWT
# ============================================
# ⚠️ CRITIQUE: Générer une clé sécurisée avec:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REMPLACER_PAR_SECRET_GENERE_256_BITS

# ============================================
# CORS - Origins Autorisées
# ============================================
# ⚠️ IMPORTANT: Remplacer par l'URL exacte de votre frontend Railway
# Récupérer l'URL depuis: Railway Dashboard → Service Frontend → Settings → Domains
# Format: https://votre-app.up.railway.app (PAS de slash final)
ALLOWED_ORIGINS=https://VOTRE-FRONTEND.up.railway.app

# Alternative: définir une seule origin principale
# CORS_ORIGIN=https://VOTRE-FRONTEND.up.railway.app

# ============================================
# FRONTEND URL (pour les emails)
# ============================================
# ⚠️ IMPORTANT: Même URL que ALLOWED_ORIGINS
FRONTEND_URL=https://VOTRE-FRONTEND.up.railway.app

# ============================================
# EMAIL - Configuration SMTP
# ============================================
# Choisir UN fournisseur parmi les options ci-dessous:

# --- OPTION 1: Gmail (Développement/Test) ---
# 1. Activer 2FA sur votre compte Google
# 2. Créer un "App Password": https://myaccount.google.com/apppasswords
# 3. Utiliser ce password (16 caractères) ci-dessous
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=votre-email@gmail.com
EMAIL_PASSWORD=REMPLACER_PAR_APP_PASSWORD_GMAIL
EMAIL_FROM=noreply@wiw-ae-plus.com

# --- OPTION 2: SendGrid (Production Recommandé) ---
# 1. Créer compte SendGrid: https://signup.sendgrid.com/
# 2. Créer API Key: Settings → API Keys
# 3. Vérifier votre domaine d'envoi (Sender Authentication)
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_SECURE=false
# EMAIL_USER=apikey
# EMAIL_PASSWORD=VOTRE_API_KEY_SENDGRID
# EMAIL_FROM=noreply@votre-domaine.com

# --- OPTION 3: Mailgun ---
# 1. Créer compte Mailgun: https://signup.mailgun.com/
# 2. Récupérer SMTP credentials depuis Dashboard
# EMAIL_HOST=smtp.mailgun.org
# EMAIL_PORT=587
# EMAIL_SECURE=false
# EMAIL_USER=VOTRE_USERNAME_MAILGUN
# EMAIL_PASSWORD=VOTRE_PASSWORD_MAILGUN
# EMAIL_FROM=noreply@votre-domaine.com

# --- OPTION 4: AWS SES (Enterprise) ---
# EMAIL_HOST=email-smtp.us-east-1.amazonaws.com
# EMAIL_PORT=587
# EMAIL_SECURE=false
# EMAIL_USER=VOTRE_ACCESS_KEY_AWS
# EMAIL_PASSWORD=VOTRE_SECRET_KEY_AWS
# EMAIL_FROM=noreply@votre-domaine.com

# ============================================
# RATE LIMITING
# ============================================
# Fenêtre de temps en millisecondes (15 minutes par défaut)
RATE_LIMIT_WINDOW_MS=900000

# Nombre max de requêtes par fenêtre (ajuster selon votre trafic)
# Valeurs recommandées:
# - Petit trafic (<1000 users/jour): 100
# - Moyen trafic (1000-10000): 200
# - Gros trafic (>10000): 500
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# OPTIONNEL - Monitoring & Debug
# ============================================
# Sentry pour tracking d'erreurs (optionnel)
# SENTRY_DSN=https://...@sentry.io/...

# Mode debug CORS (JAMAIS en production!)
# CORS_ALLOW_ALL=false

# Autoriser requêtes sans origin (Postman, mobile apps)
# En production, à définir seulement si nécessaire
# CORS_ALLOW_BROWSERLESS=false

# ============================================
# NOTES IMPORTANTES
# ============================================
#
# 1. SÉCURITÉ:
#    - JWT_SECRET doit être différent entre dev et prod
#    - Générer avec crypto.randomBytes(64) minimum
#    - Ne JAMAIS committer le fichier .env
#
# 2. CORS:
#    - Pas de wildcards (*) en production
#    - URLs exactes uniquement
#    - Pas de slash final dans les URLs
#
# 3. EMAIL:
#    - Tester l'envoi d'email avant mise en prod
#    - Vérifier les spams lors du test
#    - Utiliser un service professionnel (SendGrid, Mailgun)
#
# 4. RATE LIMITING:
#    - Valeurs par défaut adaptées à un usage normal
#    - Surveiller les logs pour ajuster si nécessaire
#    - En cas d'attaque, réduire temporairement
#
# 5. BASE DE DONNÉES:
#    - Activer les backups Railway
#    - Connexion SSL automatique avec Railway
#    - Monitoring des performances via Railway Dashboard
#
# ============================================
# VÉRIFICATION PRE-DÉPLOIEMENT
# ============================================
#
# Avant de déployer, vérifier:
# [ ] JWT_SECRET généré et différent de dev
# [ ] ALLOWED_ORIGINS contient l'URL frontend correcte
# [ ] FRONTEND_URL identique à ALLOWED_ORIGINS
# [ ] EMAIL_* configuré avec credentials valides
# [ ] DATABASE_URL référence bien le service Postgres
# [ ] Aucune variable avec valeur "REMPLACER_PAR_..."
# [ ] NODE_ENV=production
# [ ] Rate limits adaptés au trafic attendu
#
# ============================================
