{
  "name": "wiw-frontend",
  "version": "1.0.0",
  "type": "module",
  "description": "Application WIW en vanilla JavaScript",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview",
    "check": "node check-build.js",
    "test": "vitest",
